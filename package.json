{
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "name": "core-radar",
  "version": "1.0.0",
  "description": "A weather radar and alert viewer",
  "main": "index.js",
  "scripts": {
    "build": "esbuild app=src/index.ts worker=node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --outdir=public --splitting --chunk-names=maplibre-chunk --minify --format=esm --sourcemap",
    "watch": "esbuild app=src/index.ts worker=node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --outdir=public --splitting --chunk-names=maplibre-chunk --minify --format=esm --sourcemap --watch"
  },
  "author": "mbg206",
  "license": "ISC",
  "dependencies": {
    "maplibre-gl": "^6.7.0"
  }
}
